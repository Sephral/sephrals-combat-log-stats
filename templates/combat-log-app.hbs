<div class="scls-app">
  {{#unless hasLog}}
  {{#unless hasHistory}}
  <section class="scls-empty">
    <h2>{{sclsLocalize "SCLS.App.NoLogTitle"}}</h2>
    <p>{{sclsLocalize "SCLS.App.NoLog"}}</p>
  </section>
  {{/unless}}
  {{/unless}}

  {{#if tabNavigation.hasTabs}}
  <nav class="scls-tabs">
    <div class="scls-tab-group scls-tab-group--history">
      <button type="button" class="{{#if tabNavigation.historyTab.active}}is-active{{/if}}" data-action="switchTab" data-tab="{{tabNavigation.historyTab.id}}" title="{{tabNavigation.historyTab.label}}"><i class="{{tabNavigation.historyTab.icon}}" aria-hidden="true"></i><span>{{tabNavigation.historyTab.label}}</span></button>
    </div>
    {{#if tabNavigation.showConnector}}
    <div class="scls-tab-connector" aria-hidden="true">
      <span>{{tabNavigation.connectorLabel}}</span>
      <i class="{{tabNavigation.connectorIcon}}"></i>
    </div>
    <div class="scls-tab-group scls-tab-group--details">
      {{#each tabNavigation.detailTabs}}
      <button type="button" class="{{#if this.active}}is-active{{/if}}" data-action="switchTab" data-tab="{{this.id}}" title="{{this.label}}"><i class="{{this.icon}}" aria-hidden="true"></i><span>{{this.label}}</span></button>
      {{/each}}
    </div>
    {{/if}}
  </nav>
  {{/if}}

  <main class="scls-body">
    <section class="scls-panel" data-panel="history">
      <h3>{{sclsLocalize "SCLS.Tab.history"}}</h3>
      {{#if historyRows.length}}
      <table class="scls-table scls-history-table">
        <thead><tr><th></th><th>{{sclsLocalize "SCLS.Label.Combat"}}</th><th>{{sclsLocalize "SCLS.Label.Status"}}</th><th>{{sclsLocalize "SCLS.Label.Started"}}</th><th>{{sclsLocalize "SCLS.Label.Ended"}}</th><th>{{sclsLocalize "SCLS.Label.Rounds"}}</th><th>{{sclsLocalize "SCLS.Label.Participants"}}</th><th>{{sclsLocalize "SCLS.Label.NetDamage"}}</th><th>{{sclsLocalize "SCLS.Label.PartyDPR"}}</th><th>{{sclsLocalize "SCLS.Label.Actions"}}</th></tr></thead>
        <tbody>
          {{#each historyRows}}
          <tr class="{{#if this.selected}}is-selected{{/if}}">
            <td class="scls-history-select-cell"><button type="button" data-action="openLog" data-log-id="{{this.combatLogId}}" title="{{sclsLocalize "SCLS.Button.Open"}}"><i class="fa-solid fa-folder-open" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Button.Open"}}</span></button></td>
            <td class="scls-history-combat-cell"><strong>{{this.title}}</strong><span>{{this.loadedLabel}}</span></td>
            <td><span class="scls-status scls-status--{{this.status}}">{{this.statusLabel}}</span></td>
            <td>{{this.startedLabel}}</td>
            <td>{{this.endedLabel}}</td>
            <td>{{this.rounds}}</td>
            <td>{{this.participantCount}}</td>
            <td>{{this.netDamageApplied}}</td>
            <td>{{this.partyDPR}}</td>
            <td>
              <div class="scls-history-actions">
                <button type="button" class="scls-button--danger scls-button--icon" data-action="deleteLog" data-log-id="{{this.combatLogId}}" data-log-title="{{this.title}}" title="{{sclsLocalize "SCLS.Button.Delete"}}" aria-label="{{sclsLocalize "SCLS.Button.Delete"}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="scls-muted">{{sclsLocalize "SCLS.Label.NoHistory"}}</p>
      {{/if}}
    </section>

  {{#if hasLog}}
  <header class="scls-header" data-detail-only>
    <div class="scls-title-block">
      <form class="scls-title-form">
        <label>
          <span>{{sclsLocalize "SCLS.Label.CombatName"}}</span>
          <input type="text" name="title" value="{{log.title}}">
        </label>
        <button type="button" data-action="renameLog" title="{{sclsLocalize "SCLS.Button.RenameCombat"}}"><i class="fa-solid fa-pen" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Button.RenameCombat"}}</span></button>
      </form>
      <div class="scls-meta-line">
        <span class="scls-status scls-status--{{summary.status}}">{{summary.statusLabel}}</span>
        <span>{{summary.roundsLabel}}</span>
        <span>{{summary.sessionsLabel}}</span>
        {{#if summary.isShared}}<span class="scls-shared-badge"><i class="fa-solid fa-users" aria-hidden="true"></i> {{sclsLocalize "SCLS.Share.Shared"}}</span>{{/if}}
      </div>
    </div>
    <div class="scls-header__stats scls-header__stats--damage">
      <strong>{{computed.summary.netDamageApplied}}</strong>
      <span>{{sclsLocalize "SCLS.Label.NetDamage"}}</span>
    </div>
    <div class="scls-header__stats scls-header__stats--dpr">
      <strong>{{computed.dpr.partyDPR}}</strong>
      <span>{{sclsLocalize "SCLS.Label.PartyDPR"}}</span>
    </div>
  </header>

    <section class="scls-panel" data-panel="summary">
      <h3>{{sclsLocalize "SCLS.Tab.summary"}}</h3>
      <div class="scls-grid scls-grid--cards">
        <div class="scls-metric"><span>{{sclsLocalize "SCLS.Label.Started"}}</span><strong>{{summary.startedAt}}</strong></div>
        <div class="scls-metric"><span>{{sclsLocalize "SCLS.Label.Ended"}}</span><strong>{{summary.endedAt}}</strong></div>
        <div class="scls-metric"><span>{{sclsLocalize "SCLS.Label.Duration"}}</span><strong>{{summary.activeDuration}}</strong></div>
        <div class="scls-metric"><span>{{sclsLocalize "SCLS.Label.Participants"}}</span><strong>{{summary.participants}}</strong></div>
        <div class="scls-metric scls-metric--damage"><span>{{sclsLocalize "SCLS.Label.NetDamage"}}</span><strong>{{computed.summary.netDamageApplied}}</strong></div>
        <div class="scls-metric scls-metric--healing"><span>{{sclsLocalize "SCLS.Label.NetHealing"}}</span><strong>{{computed.summary.netHealingApplied}}</strong></div>
        <div class="scls-metric scls-metric--hostile"><span>{{sclsLocalize "SCLS.Label.EnemiesDefeated"}}</span><strong>{{summary.enemiesDefeated}}</strong></div>
        <div class="scls-metric scls-metric--friendly"><span>{{sclsLocalize "SCLS.Label.PartyDowned"}}</span><strong>{{summary.partyDowned}}</strong></div>
        <div class="scls-metric"><span>{{sclsLocalize "SCLS.Label.CriticalHits"}}</span><strong>{{summary.criticalHits}}</strong></div>
        <div class="scls-metric scls-metric--correction"><span>{{sclsLocalize "SCLS.Label.Corrections"}}</span><strong>+{{computed.summary.damageCorrectionsUp}} / -{{computed.summary.damageCorrectionsDown}}</strong></div>
      </div>
      {{#if summary.warnings.length}}
      <div class="scls-warning-list">
        {{#each summary.warnings}}<p>{{this}}</p>{{/each}}
      </div>
      {{/if}}
      <h4>{{sclsLocalize "SCLS.Metrics.Contributions"}}</h4>
      {{#if combatMetrics.contributionRows.length}}
      <div class="scls-metrics-list">
        {{#each combatMetrics.contributionRows}}
        <div class="scls-metrics-row">
          <span class="scls-combatant-cell"><img class="scls-avatar--tiny" src="{{this.img}}" alt=""><span class="scls-combatant-name">{{this.name}}</span></span>
          <div class="scls-metrics-bars">
            <span class="scls-meter scls-meter--damage" style="--scls-bar: {{this.damagePercent}}%"><i></i></span>
            <span class="scls-meter scls-meter--healing" style="--scls-bar: {{this.healingPercent}}%"><i></i></span>
          </div>
          <div class="scls-impact-badges" aria-label="{{sclsLocalize "SCLS.Metrics.Contributions"}}">
            {{#each this.impactMetrics}}
            <span class="scls-impact-badge scls-impact-badge--{{this.type}}" title="{{this.label}}"><i class="{{this.icon}}" aria-hidden="true"></i><strong>{{this.value}}</strong></span>
            {{/each}}
          </div>
        </div>
        {{/each}}
      </div>
      {{else}}
      <p class="scls-muted">{{sclsLocalize "SCLS.Label.NoParticipants"}}</p>
      {{/if}}
    </section>

    <section class="scls-panel" data-panel="dpr">
      <h3>{{sclsLocalize "SCLS.Tab.dpr"}}</h3>
      <div class="scls-grid scls-grid--cards">
        <div class="scls-metric scls-metric--friendly"><span>{{sclsLocalize "SCLS.Label.PartyDPR"}}</span><strong>{{computed.dpr.partyDPR}}</strong></div>
        <div class="scls-metric scls-metric--hostile"><span>{{sclsLocalize "SCLS.Label.EnemyDPR"}}</span><strong>{{computed.dpr.enemyDPR}}</strong></div>
        <div class="scls-metric"><span>{{sclsLocalize "SCLS.Label.NeutralDPR"}}</span><strong>{{computed.dpr.neutralDPR}}</strong></div>
        <div class="scls-metric"><span>{{sclsLocalize "SCLS.Label.DprMethod"}}</span><strong>{{dprMethodLabel}}</strong></div>
      </div>
      {{#if dprRows.length}}
      <table class="scls-table">
        <thead><tr>{{#each dprColumns}}<th><button type="button" class="scls-sort-button {{#if this.active}}is-active{{/if}}" data-action="sortDpr" data-sort-key="{{this.key}}" title="{{this.label}}"><span>{{this.label}}</span><i class="{{this.icon}}" aria-hidden="true"></i></button></th>{{/each}}</tr></thead>
        <tbody>
          {{#each dprRows}}
          <tr class="scls-side--{{this.side}}"><td><span class="scls-combatant-cell"><img class="scls-avatar--tiny" src="{{this.img}}" alt="">{{this.name}}</span></td><td>{{this.sideLabel}}</td><td>{{this.damageAppliedNet}}</td><td>{{this.damageTakenNet}}</td><td>{{this.healing}}</td><td>{{this.martial}}</td><td>{{this.ranged}}</td><td>{{this.magic}}</td><td>{{this.control}}</td><td>{{this.takedowns}}</td><td>{{this.downed}}</td><td>{{this.netDPR}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="scls-muted">{{sclsLocalize "SCLS.Label.NoParticipants"}}</p>
      {{/if}}
    </section>

    <section class="scls-panel" data-panel="corrections">
      <h3>{{sclsLocalize "SCLS.Tab.corrections"}}</h3>
      <p class="scls-muted">{{sclsLocalize "SCLS.Label.AutomaticCorrections"}}</p>
      {{#if correctionEvents.length}}
      <table class="scls-table">
        <thead><tr><th>{{sclsLocalize "SCLS.Label.Round"}}</th><th>{{sclsLocalize "SCLS.Label.Target"}}</th><th>{{sclsLocalize "SCLS.Label.Delta"}}</th><th>{{sclsLocalize "SCLS.Label.Interpretation"}}</th><th>{{sclsLocalize "SCLS.Label.Source"}}</th><th>{{sclsLocalize "SCLS.Label.Reason"}}</th><th>{{sclsLocalize "SCLS.Label.Actions"}}</th></tr></thead>
        <tbody>
          {{#each correctionEvents}}
          <tr class="{{#if this.ignored}}is-muted{{/if}}">
            <td>{{this.roundLabel}}</td>
            <td><strong>{{this.targetName}}</strong><span class="scls-cell-note">{{this.label}}</span></td>
            <td>{{this.data.oldValue}} → {{this.data.newValue}} ({{this.data.delta}})</td>
            <td>
              <select data-scls-action="classify" data-event-id="{{this.id}}" aria-label="{{sclsLocalize "SCLS.Label.Interpretation"}}">
                {{#each this.interpretationOptions}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </select>
            </td>
            <td>
              <select data-scls-action="setSource" data-event-id="{{this.id}}" aria-label="{{sclsLocalize "SCLS.Label.Source"}}">
                {{#each this.sourceOptions}}
                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </select>
            </td>
            <td>{{this.reasonLabel}}</td>
            <td>
              {{#if this.ignored}}
              <button type="button" data-action="restoreEvent" data-event-id="{{this.id}}" title="{{sclsLocalize "SCLS.Button.Restore"}}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Button.Restore"}}</span></button>
              {{else}}
              <button type="button" data-action="ignoreEvent" data-event-id="{{this.id}}" title="{{sclsLocalize "SCLS.Button.Ignore"}}"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Button.Ignore"}}</span></button>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="scls-muted">{{sclsLocalize "SCLS.Label.NoCorrections"}}</p>
      {{/if}}

      <h4>{{sclsLocalize "SCLS.Manual.Title"}}</h4>
      <form class="scls-adjustment-form">
        <label><span>{{sclsLocalize "SCLS.Manual.Type"}}</span>
          <select name="adjustmentType">{{#each manualTypeOptions}}<option value="{{this.value}}">{{this.label}}</option>{{/each}}</select>
        </label>
        <label><span>{{sclsLocalize "SCLS.Manual.Amount"}}</span><input type="number" name="adjustmentAmount" min="1" step="1" value="1"></label>
        <label><span>{{sclsLocalize "SCLS.Label.Source"}}</span>
          <select name="adjustmentSource">{{#each participantOptions}}<option value="{{this.value}}">{{this.label}}</option>{{/each}}</select>
        </label>
        <label><span>{{sclsLocalize "SCLS.Label.Target"}}</span>
          <select name="adjustmentTarget">{{#each participantOptions}}<option value="{{this.value}}">{{this.label}}</option>{{/each}}</select>
        </label>
        <label class="scls-adjustment-note"><span>{{sclsLocalize "SCLS.Manual.Note"}}</span><input type="text" name="adjustmentNote" maxlength="200"></label>
        <button type="button" data-action="addAdjustment" title="{{sclsLocalize "SCLS.Manual.Add"}}"><i class="fa-solid fa-plus" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Manual.Add"}}</span></button>
      </form>
      {{#if manualAdjustmentEvents.length}}
      <table class="scls-table">
        <thead><tr><th>{{sclsLocalize "SCLS.Label.Time"}}</th><th>{{sclsLocalize "SCLS.Manual.Type"}}</th><th>{{sclsLocalize "SCLS.Label.Source"}}</th><th>{{sclsLocalize "SCLS.Label.Target"}}</th><th>{{sclsLocalize "SCLS.Manual.Amount"}}</th><th>{{sclsLocalize "SCLS.Manual.Note"}}</th><th>{{sclsLocalize "SCLS.Label.Actions"}}</th></tr></thead>
        <tbody>
          {{#each manualAdjustmentEvents}}
          <tr class="{{#if this.ignored}}is-muted{{/if}}">
            <td>{{this.createdLabel}}</td>
            <td>{{this.label}}</td>
            <td>{{this.participantName}}</td>
            <td>{{this.targetName}}</td>
            <td>{{this.amount}}</td>
            <td>{{this.note}}</td>
            <td>
              {{#if this.ignored}}
              <button type="button" data-action="restoreEvent" data-event-id="{{this.id}}" title="{{sclsLocalize "SCLS.Button.Restore"}}"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Button.Restore"}}</span></button>
              {{else}}
              <button type="button" data-action="ignoreEvent" data-event-id="{{this.id}}" title="{{sclsLocalize "SCLS.Button.Ignore"}}"><i class="fa-solid fa-eye-slash" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Button.Ignore"}}</span></button>
              {{/if}}
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{/if}}
    </section>

    <section class="scls-panel" data-panel="participants">
      <h3>{{sclsLocalize "SCLS.Tab.participants"}}</h3>
      {{#if participants.length}}
      <table class="scls-table">
        <thead><tr><th>{{sclsLocalize "SCLS.Label.Name"}}</th><th>{{sclsLocalize "SCLS.Label.Side"}}</th><th>{{sclsLocalize "SCLS.Label.Initiative"}}</th><th>{{sclsLocalize "SCLS.Label.DamageDealt"}}</th><th>{{sclsLocalize "SCLS.Label.DamageTaken"}}</th><th>{{sclsLocalize "SCLS.Label.Healing"}}</th><th>{{sclsLocalize "SCLS.Label.NetDPR"}}</th></tr></thead>
        <tbody>
          {{#each participants}}
          <tr>
            <td><span class="scls-combatant-cell"><img src="{{this.img}}" alt="">{{this.name}}{{#if this.hidden}} <i class="fa-solid fa-eye-slash scls-muted" title="{{sclsLocalize "SCLS.Label.Hidden"}}"></i>{{/if}}</span></td>
            <td><select data-scls-action="setSide" data-combatant-id="{{this.combatantId}}" aria-label="{{sclsLocalize "SCLS.Label.Side"}}">{{#each this.sideOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select></td>
            <td>{{this.initiative}}</td>
            <td>{{this.stats.damageAppliedNet}}</td>
            <td>{{this.stats.damageTakenNet}}</td>
            <td>{{this.stats.healingNet}}</td>
            <td>{{this.stats.netDPR}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="scls-muted">{{sclsLocalize "SCLS.Label.NoParticipants"}}</p>
      {{/if}}
    </section>

    <section class="scls-panel" data-panel="timeline">
      <h3>{{sclsLocalize "SCLS.Tab.timeline"}}</h3>
      {{#if combatRounds.length}}
      <ol class="scls-round-log">
        {{#each combatRounds}}
        <li>
          <details class="scls-round" {{#if this.open}}open{{/if}}>
            <summary>
              <strong>{{sclsLocalize "SCLS.Label.Round"}} {{this.round}}</strong>
              <span>{{this.summary}}</span>
            </summary>
            <table class="scls-round-table">
              <thead><tr><th>{{sclsLocalize "SCLS.Label.Actor"}}</th><th>{{sclsLocalize "SCLS.Label.Action"}}</th><th>{{sclsLocalize "SCLS.Label.Target"}}</th><th>{{sclsLocalize "SCLS.Label.Amount"}}</th><th>{{sclsLocalize "SCLS.Label.Confidence"}}</th></tr></thead>
              <tbody>
                {{#each this.actions}}
                <tr class="scls-action--{{this.kind}} scls-side--{{this.side}}"><td>{{this.actor}}</td><td><strong>{{this.verb}}</strong>{{#if this.detail}}<span>{{this.detail}}</span>{{/if}}</td><td>{{this.target}}</td><td>{{this.amountLabel}}</td><td>{{this.confidenceLabel}}</td></tr>
                {{/each}}
              </tbody>
            </table>
          </details>
        </li>
        {{/each}}
      </ol>
      {{else}}
      <p class="scls-muted">{{sclsLocalize "SCLS.Protocol.NoActions"}}</p>
      {{/if}}
    </section>

    <section class="scls-panel" data-panel="statistics">
      <h3>{{sclsLocalize "SCLS.Tab.statistics"}}</h3>
      <div class="scls-metrics-layout">
        <section class="scls-metrics-block">
          <h4>{{sclsLocalize "SCLS.Metrics.DisciplineMix"}}</h4>
          <div class="scls-discipline-grid">
            {{#each combatMetrics.disciplineRows}}
            <div class="scls-discipline scls-discipline--{{this.tone}}">
              <span>{{this.label}}</span>
              <strong>{{this.value}}</strong>
              <i style="--scls-bar: {{this.percent}}%"></i>
            </div>
            {{/each}}
          </div>
        </section>
        <section class="scls-metrics-block">
          <h4>{{sclsLocalize "SCLS.Metrics.Pressure"}}</h4>
          <div class="scls-metrics-list">
            {{#each combatMetrics.pressureRows}}
            <div class="scls-metrics-row scls-metrics-row--compact">
              <span>{{this.label}}</span>
              <span class="scls-meter" style="--scls-bar: {{this.pressurePercent}}%"><i></i></span>
              <strong>{{this.damageAppliedNet}} / {{this.netDPR}}</strong>
            </div>
            {{/each}}
          </div>
        </section>
      </div>
      <h4>{{sclsLocalize "SCLS.Metrics.TopActions"}}</h4>
      {{#if combatMetrics.topActions.length}}
      <table class="scls-table">
        <thead><tr><th>{{sclsLocalize "SCLS.Label.Action"}}</th><th>{{sclsLocalize "SCLS.Metrics.Kind"}}</th><th>{{sclsLocalize "SCLS.Metrics.Users"}}</th><th>{{sclsLocalize "SCLS.Metrics.Uses"}}</th><th>{{sclsLocalize "SCLS.Label.Amount"}}</th><th>{{sclsLocalize "SCLS.Metrics.Average"}}</th></tr></thead>
        <tbody>
          {{#each combatMetrics.topActions}}
          <tr><td><strong>{{this.name}}</strong></td><td>{{this.kindLabel}}</td><td>{{this.actors}}</td><td>{{this.uses}}</td><td>{{this.amount}}</td><td>{{this.average}}</td></tr>
          {{/each}}
        </tbody>
      </table>
      {{else}}
      <p class="scls-muted">{{sclsLocalize "SCLS.Metrics.NoActions"}}</p>
      {{/if}}
      <table class="scls-table">
        <thead><tr><th>{{sclsLocalize "SCLS.Label.Side"}}</th><th>{{sclsLocalize "SCLS.Label.DamageRolled"}}</th><th>{{sclsLocalize "SCLS.Label.DamageDealt"}}</th><th>{{sclsLocalize "SCLS.Label.DamageTaken"}}</th><th>{{sclsLocalize "SCLS.Label.Healing"}}</th><th>{{sclsLocalize "SCLS.Label.NetDPR"}}</th></tr></thead>
        <tbody>
          {{#each sideRows}}
          <tr><td>{{this.label}}</td><td>{{this.damageRolled}}</td><td>{{this.damageAppliedNet}}</td><td>{{this.damageTakenNet}}</td><td>{{this.healingNet}}</td><td>{{this.netDPR}}</td></tr>
          {{/each}}
        </tbody>
      </table>
    </section>

    <section class="scls-panel" data-panel="sharing">
      <h3>{{sclsLocalize "SCLS.Tab.sharing"}}</h3>
      <p class="scls-share-status {{#if sharing.isShared}}is-shared{{/if}}"><i class="fa-solid {{#if sharing.isShared}}fa-users{{else}}fa-user-lock{{/if}}" aria-hidden="true"></i> {{sharing.statusLabel}}</p>
      {{#unless sharing.sharingEnabled}}<p class="scls-warning-list">{{sclsLocalize "SCLS.Share.Disabled"}}</p>{{/unless}}
      <form class="scls-share-form">
        <div class="scls-share-options">
          <label><span>{{sclsLocalize "SCLS.Share.Mode"}}</span>
            <select name="shareMode">{{#each sharing.modeOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
          </label>
          <label class="scls-checkbox"><input type="checkbox" name="includeEnemyStats" {{#if sharing.includeEnemyStats}}checked{{/if}}> {{sclsLocalize "SCLS.Share.IncludeEnemyStats"}}</label>
          <label class="scls-checkbox"><input type="checkbox" name="anonymizeEnemies" {{#if sharing.anonymizeEnemies}}checked{{/if}}> {{sclsLocalize "SCLS.Share.AnonymizeEnemies"}}</label>
          <label class="scls-checkbox"><input type="checkbox" name="includeHiddenCombatants" {{#if sharing.includeHiddenCombatants}}checked{{/if}}> {{sclsLocalize "SCLS.Share.IncludeHidden"}}</label>
        </div>
        <fieldset class="scls-report-sections">
          <legend>{{sclsLocalize "SCLS.Share.ReportSections"}}</legend>
          {{#each reportSectionOptions}}
          <label><input type="checkbox" name="reportSections" value="{{this.value}}" {{#if this.selected}}checked{{/if}}> {{this.label}}</label>
          {{/each}}
        </fieldset>
        <div class="scls-share-actions">
          <button type="button" data-action="saveSharing" title="{{sclsLocalize "SCLS.Button.SaveSharing"}}"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Button.SaveSharing"}}</span></button>
          <button type="button" data-action="postPlayerReport" title="{{sclsLocalize "SCLS.Button.PostPlayerReport"}}" {{#unless sharing.sharingEnabled}}disabled{{/unless}}><i class="fa-solid fa-message" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Button.PostPlayerReport"}}</span></button>
          <button type="button" data-action="createJournalReport" title="{{sclsLocalize "SCLS.Button.CreateJournalReport"}}" {{#unless sharing.sharingEnabled}}disabled{{/unless}}><i class="fa-solid fa-book-open" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Button.CreateJournalReport"}}</span></button>
          {{#if sharing.isShared}}<button type="button" class="scls-button--danger" data-action="stopSharing" title="{{sclsLocalize "SCLS.Button.StopSharing"}}"><i class="fa-solid fa-user-lock" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Button.StopSharing"}}</span></button>{{/if}}
        </div>
      </form>
      <h4>{{sclsLocalize "SCLS.Label.Export"}}</h4>
      <div class="scls-share-actions">
        <button type="button" data-action="exportJson" title="{{sclsLocalize "SCLS.Button.ExportJson"}}"><i class="fa-solid fa-file-code" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Button.ExportJson"}}</span></button>
        <button type="button" data-action="exportMarkdown" title="{{sclsLocalize "SCLS.Button.ExportMarkdown"}}"><i class="fa-brands fa-markdown" aria-hidden="true"></i><span>{{sclsLocalize "SCLS.Button.ExportMarkdown"}}</span></button>
      </div>
    </section>
  {{/if}}
  </main>
</div>
